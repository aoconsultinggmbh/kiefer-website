# Servereinstellungen fuer den echten Webserver (Apache, z. B. All-Inkl).
# Auf der GitHub-Vorschau wird diese Datei ignoriert. VOR DEM LIVEGANG auf dem Server testen.

RewriteEngine On

# Die Uebergangsadresse des Hosters (…kasserver.com) NICHT umleiten.
# Sonst laesst sich die Seite vor dem Domain-Umzug nicht auf dem echten
# Server testen - jeder Aufruf landet sofort wieder auf der alten Seite.
# Diese Regel muss VOR der Umleitung stehen und bleibt auch nach dem
# Livegang drin: sie stoert nicht und rettet den naechsten Test.
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# Alles andere: immer https und immer www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.dental-kiefer.de/$1 [R=301,L]

# --- Alte Adressen der Vorgaengerseite -------------------------------------
# Die alte Seite lief auf PHP-Dateien. Damit Google-Treffer und Lesezeichen
# nicht ins Leere laufen, zeigt jede alte Adresse dauerhaft (301) auf die
# passende neue Stelle. Diese Zuordnung bitte einmal gegenlesen.
Redirect 301 /index.php                /
Redirect 301 /ansprechpartner.php      /ansprechpartner.html
Redirect 301 /ansprechpartner_team.php /ansprechpartner.html
Redirect 301 /team.php                 /ansprechpartner.html
Redirect 301 /portrait.php             /ueber-uns.html
Redirect 301 /philosophie.php          /ueber-uns.html
Redirect 301 /dentallabor.php          /ueber-uns.html
Redirect 301 /qualitaet.php            /ueber-uns.html
Redirect 301 /rundgang.php             /ueber-uns.html
Redirect 301 /schulung.php             /ueber-uns.html
Redirect 301 /garantie.php             /ueber-uns.html
Redirect 301 /leistungsuebersicht.php  /#leistungen
Redirect 301 /logistik.php             /#ablauf
Redirect 301 /beratung.php             /#kontakt
Redirect 301 /anfahrt.php              /#kontakt
Redirect 301 /kontakt.php              /#kontakt
Redirect 301 /_datenschutzhinweis.php  /datenschutz.html

ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
  # HTML nie zwischenspeichern: sonst sehen Besucher (und wir beim
  # Testen) nach einer Aenderung stundenlang die alte Seite.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
